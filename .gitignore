# OS / editor
.DS_Store

# Local tooling (preview server config, etc.)
/.claude/
/surge-dist/

# Surge local domain file. Use `npx surge . last-hd.surge.sh` instead of
# committing a CNAME that would also affect GitHub Pages.
/CNAME

# Paper files are kept local only for the anonymous review site.
/paper/
/assets/paper/main.pdf

# LaTeX build artifacts
assets/paper/*.aux
assets/paper/*.bbl
assets/paper/*.blg
assets/paper/*.fdb_latexmk
assets/paper/*.fls
assets/paper/*.log
assets/paper/*.out
